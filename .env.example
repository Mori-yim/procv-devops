# Application
IMAGE_TAG=1.0.0
DOCKERHUB_USERNAME=your-dockerhub-username
APP_ALLOWED_ORIGINS=http://localhost:4200
JWT_EXPIRATION_MS=86400000

# MySQL — replace every CHANGE_ME value before starting
MYSQL_DATABASE=procv
MYSQL_USER=procv_app
MYSQL_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_STRONG_ROOT_PASSWORD

# At least 32 random characters. Example only: replace it.
JWT_SECRET=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
